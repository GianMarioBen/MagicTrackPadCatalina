<?xml version="1.0" encoding="UTF-8"?>
<!--
  Avvio automatico del bridge al login.

  Installazione:
    make
    sudo cp build/mammetta_bridge /usr/local/bin/
    cp tools/com.mammetta.trackpad.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.mammetta.trackpad.plist

  Va concesso a /usr/local/bin/mammetta_bridge (non al Terminale) il
  permesso di Monitoraggio Input e di Accessibilita'.

  Disinstallazione:
    launchctl unload ~/Library/LaunchAgents/com.mammetta.trackpad.plist
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.mammetta.trackpad</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/mammetta_bridge</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/tmp/mammetta_trackpad.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/mammetta_trackpad.err</string>

    <key>ProcessType</key>
    <string>Interactive</string>
</dict>
</plist>
